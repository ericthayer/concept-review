{
  "name": "dmns-comic-bento",
  "version": "0.1.0",
  "private": true,
  "description": "Concept redesign of dmns.org as a living comic book on a bento grid.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run build && node scripts/serve.ts",
    "build": "tsc -p tsconfig.client.json && node scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node scripts/lint.ts",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "playwright test",
    "check:contrast": "node scripts/check-contrast.ts",
    "check:budgets": "node scripts/check-budgets.ts",
    "check:links": "node scripts/check-links.ts",
    "check:reading-order": "node scripts/check-reading-order.ts",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run check:contrast && npm run check:budgets && npm run check:links && npm run check:reading-order && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
