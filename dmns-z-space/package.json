{
  "name": "dmns-z-space",
  "version": "0.1.0",
  "private": true,
  "description": "DMNS concept redesign: the museum at night, navigated through z-space with View Transitions.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "build": "npm run compile && node .build/scripts/build.js",
    "dev": "npm run build && npx serve dist -l 4321",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:unit": "node --test \".build/tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "check:contrast": "node .build/scripts/check-contrast.js",
    "check:budgets": "node .build/scripts/check-budgets.js",
    "check:links": "node .build/scripts/check-links.js",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test:unit && npm run check:contrast && npm run check:budgets && npm run check:links && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
